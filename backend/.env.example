# Database & Storage Settings
DATABASE_URL=sqlite+aiosqlite:///./data/talentvault.db
RESUME_STORAGE_PATH=./data/resumes
FAISS_INDEX_PATH=./data/faiss

# AI Provider Configuration
# Options: "ollama" (Local Development) | "groq" (Production Cloud API)
LLM_PROVIDER=groq

# Production Cloud LLM (Groq API)
# Get a free fast key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama Settings (Local Development)
OLLAMA_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=768
OLLAMA_TIMEOUT_SECONDS=120.0
DEBUG_PARSER=true
