# Database & Storage Settings
DATABASE_URL=sqlite+aiosqlite:///./data/talentvault.db
RESUME_STORAGE_PATH=./data/resumes
FAISS_INDEX_PATH=./data/faiss

# AI Provider Configuration
# Options: "gemini" (Production Free Cloud API) | "groq" (Cloud API) | "ollama" (Local Dev)
LLM_PROVIDER=gemini

# Google Gemini API Settings (Free Cloud API)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Production Cloud LLM (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama Settings (Local Development)
OLLAMA_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=768
OLLAMA_TIMEOUT_SECONDS=120.0
DEBUG_PARSER=true
